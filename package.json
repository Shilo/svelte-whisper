{
  "name": "svelte-whisper",
  "version": "2.0.0",
  "description": "Tiny runtime i18n for Svelte 5 single-page apps, built on runes: lazy-loaded locales, plurals and Intl formatting in under 2 kB.",
  "keywords": [
    "svelte",
    "svelte5",
    "runes",
    "i18n",
    "l10n",
    "internationalization",
    "localization",
    "translation",
    "lazy-loading",
    "spa"
  ],
  "license": "MIT",
  "author": "Shilo",
  "homepage": "https://github.com/Shilo/svelte-whisper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shilo/svelte-whisper.git"
  },
  "bugs": {
    "url": "https://github.com/Shilo/svelte-whisper/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./index.svelte.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "svelte": "./index.svelte.js",
      "default": "./index.svelte.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "svelte-whisper": "./bin/svelte-whisper.js"
  },
  "files": [
    "index.svelte.js",
    "index.d.ts",
    "dev-overlay.js",
    "bin",
    "skills",
    "llms.txt"
  ],
  "scripts": {
    "test": "node --conditions=browser --test \"test/*.test.js\"",
    "check:types": "tsc -p type-tests/tsconfig.json && tsc -p type-tests/tsconfig.untyped.json",
    "size": "node scripts/size.js",
    "bench": "node scripts/bench.js",
    "check": "npm test && npm run check:types && npm run size"
  },
  "peerDependencies": {
    "svelte": "^5.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "svelte": "^5.58.0",
    "typescript": "^7.0.2"
  }
}
